# direnv configuration for project-bifrost.
#
# Adds host/runtime/ to PATH so the `bifrost` CLI is available
# without explicit paths, and so `#!/usr/bin/env bifrost` shebangs
# in D scripts resolve.
#
# Usage:
#   brew install direnv      # one-time
#   direnv allow             # one-time, in this directory
#
# Without direnv, the equivalent one-liner per shell is:
#   export PATH="$PWD/host/runtime:$PATH"

PATH_add host/runtime
